# memes: only meta.json is tracked; scripts/library_restore.py rebuilds the media
library/memes/*/clip.webm
library/memes/*/image.png
library/memes/*/preview.png
# generated by scripts/audition.py
library/audition.html
__pycache__/
.DS_Store

# No audio file in library/sfx or library/music may ever be committed, whatever its extension (partial copies
# included): this repo is public and every sound is licensed (see library/SOURCES.md). A deployment restores them
# outside git; the manifests keep the ids only.
library/sfx/*.wav
library/music/*.wav
library/sfx/*.mp3
library/music/*.mp3
library/sfx/*.m4a
library/music/*.m4a
library/sfx/*.aac
library/music/*.aac
library/sfx/*.ogg
library/music/*.ogg
library/sfx/*.flac
library/music/*.flac
library/sfx/*.part
library/music/*.part
# licensed asset packs (overlays, transitions, sounds): restored by a deployment, never committed
library/packs/
.env

# face model: face_track.py downloads it on first use (opencv_zoo, MIT), via a temporary .part file
library/models/*.onnx
library/models/*.part
