# media is rebuilt by scripts/library_restore.py; the repo keeps manifests and meta only
library/sfx/*.wav
library/memes/*/clip.webm
library/memes/*/image.png
library/memes/*/preview.png
library/audition.html
__pycache__/
.DS_Store

# licensed/ripped media is restored by scripts/library_restore.py, never committed
library/music/*.mp3
# No audio file in either folder may ever be committed, whatever its extension: this repo is public and every
# sound is licensed (see library/SOURCES.md). A deployment restores them outside git.
library/sfx/*.mp3
library/music/*.wav
library/sfx/*.m4a
library/music/*.m4a
library/sfx/*.aac
library/music/*.aac
library/sfx/*.ogg
library/music/*.ogg
library/sfx/*.flac
library/music/*.flac
library/sfx/*.part
library/music/*.part
# licensed asset packs (overlays, transitions, sounds): restored by a deployment, never committed
library/packs/
.env

# face model: face_track.py downloads it on first use (opencv_zoo, MIT)
library/models/*.onnx
# Lottie animations: the manifest is committed, the files are restored by a deployment
library/lottie/*.json
!library/lottie/manifest.json
